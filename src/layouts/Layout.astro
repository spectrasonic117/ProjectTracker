---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tablero de proyectos con drag & drop, estilo Apple." />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230a84ff'/%3E%3Cpath d='M9 13.5 16 9l7 4.5-7 4.5-7-4.5Z' fill='white'/%3E%3Cpath d='m9 18.5 7 4.5 7-4.5' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' opacity='.7'/%3E%3C/svg%3E"
    />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado para evitar el destello.
      (() => {
        try {
          const stored = localStorage.getItem('project-tracker/theme');
          const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* sin localStorage se respeta el tema del sistema */
        }
      })();
    </script>
  </head>
  <body class="bg-[#f5f5f7] text-neutral-900 dark:bg-[#0b0b0d] dark:text-neutral-100">
    <slot />
  </body>
</html>
