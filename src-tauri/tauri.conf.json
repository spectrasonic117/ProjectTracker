{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectTracker",
  "version": "0.1.0",
  "identifier": "com.spectrasonic.projecttracker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectTracker",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Tablero de proyectos estilo Trello",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
